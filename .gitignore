# ---------------------------------------------------------------------------
# Virtual environments  (2.2 GB - never commit; recreate from requirements.txt)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Datasets  (downloaded automatically on first run by src/data_loader.py)
#   data/raw/emnist_gzip.zip  ~536 MB   - exceeds GitHub's 100 MB file limit
#   data/raw/mnist.npz         ~11 MB
#   data/processed/*.npz       ~65 MB   - regenerated caches
# ---------------------------------------------------------------------------
data/raw/
data/processed/

# ---------------------------------------------------------------------------
# Fitted baseline models  (1.3 GB - random forest alone is 1.2 GB)
# Reproduce with: python src/baseline.py
# ---------------------------------------------------------------------------
models/baseline/
*.joblib

# ---------------------------------------------------------------------------
# Per-experiment CNN checkpoints (~35 MB) - reproduce with src/train.py.
# The exported final model IS committed, so the web app works out of the box.
# ---------------------------------------------------------------------------
models/final/*.keras
!models/final/handwritten_character_cnn.keras

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
